# ════════════════════════════════════════════════════════════════════════════
#  R3STO Backend Configuration
#  Copy this to .env and fill in your values
# ════════════════════════════════════════════════════════════════════════════

# Server
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
DB_PATH=./data/r3sto.db

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# CORS Configuration
CORS_ORIGINS=https://app.r3sto.ch,https://booking.r3sto.ch,https://admin.r3sto.ch,http://localhost:5173,http://localhost:3000

# Email (for notifications - optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@r3sto.ch

# Demo mode (seed data)
DEMO_MODE=false
