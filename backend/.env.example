# ─── R3STO Backend — variables d'environnement ───
# Copier ce fichier vers .env et remplir les valeurs réelles.
# NE JAMAIS commiter le fichier .env.

# ── App ──
NODE_ENV=production
PORT=8080

# ── Base de données MariaDB Infomaniak ──
DB_HOST=pl7wy9.myd.infomaniak.com
DB_PORT=3306
DB_USER=pl7wy9_R3STO
DB_PASSWORD=
DB_NAME=pl7wy9_R3STO

# ── Sécurité ──
JWT_SECRET=
JWT_EXPIRES=30d
SETUP_KEY=

# ── CORS — domaines autorisés (séparés par virgule) ──
CORS_ORIGINS=https://r3sto.ch,https://www.r3sto.ch,https://app.r3sto.ch,https://admin.r3sto.ch,https://demo.r3sto.ch,https://booking.r3sto.ch,https://auth.r3sto.ch

# ── SMTP Infomaniak ──
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=noreply@r3sto.ch
SMTP_PASSWORD=
SMTP_FROM="R3STO <noreply@r3sto.ch>"

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Superadmin par défaut (créé à la première migration si absent) ──
SUPERADMIN_EMAIL=didier@r3sto.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Didier
