# R3STO API — variables d'environnement
# Ne JAMAIS commit ce fichier avec les vraies valeurs (copier en .env localement)

# ── DB MariaDB Infomaniak ────────────────────────
DB_HOST=pl7wy9.myd.infomaniak.com
DB_PORT=3306
DB_USER=pl7wy9_R3STO
DB_PASSWORD=
DB_NAME=pl7wy9_R3STO
DB_POOL_SIZE=10

# ── JWT (générer une chaîne aléatoire 64+ chars) ──
JWT_SECRET=
JWT_EXPIRES=30d
SETUP_KEY=

# ── SMTP Infomaniak ──────────────────────────────
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@r3sto.ch
SMTP_PASSWORD=
FROM_EMAIL=noreply@r3sto.ch
ADMIN_EMAIL=contact@r3sto.com

# ── Stripe (à brancher quand prêt) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CORS (origines autorisées, csv) ──────────────
ALLOWED_ORIGINS=https://r3sto.com,https://www.r3sto.com,https://app.r3sto.com,https://admin.r3sto.com,https://demo.r3sto.com,https://mini.r3sto.com

# ── Port (Infomaniak alloue auto via process.env.PORT) ──
PORT=8080
